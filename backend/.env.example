# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MOBILE_DEEP_LINK=printplz://

# Database — local dev uses SQLite (no Docker needed).
# For production Postgres (docker compose), use:
# DATABASE_URL=postgresql://printplz:printplz@localhost:5432/printplz?schema=public
DATABASE_URL=file:./dev.db

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP (dev): fixed code accepted when set; leave empty in production + plug SMS provider
DEV_OTP_CODE=123456
OTP_TTL_MINUTES=5

# Seeded super admin
SUPERADMIN_PHONE=+919000000000
SUPERADMIN_PASSWORD=Super@123
SUPERADMIN_NAME=PrintPlz Admin

# Pricing defaults (per page, INR)
PRICE_BW_PER_PAGE=2
PRICE_COLOR_PER_PAGE=10

# Uploads (local disk; swap for S3 later)
UPLOAD_DIR=uploads
MAX_FILE_MB=15
